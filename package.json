{
  "name": "storyengine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "StoryEngine — workspace root. See docs/design/ for the design notes.",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=26.4.0"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @storyengine/shared emit-schemas && pnpm --filter @storyengine/client build",
    "dev": "pnpm --parallel --filter @storyengine/server --filter @storyengine/client run dev",
    "dev:server": "pnpm --filter @storyengine/server run dev",
    "dev:client": "pnpm --filter @storyengine/client run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm run lint:es && pnpm run lint:css",
    "lint:css": "stylelint \"packages/**/*.css\"",
    "lint:es": "eslint . --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.tools.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-headers": "1.3.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.9.0",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-use-logical": "2.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
