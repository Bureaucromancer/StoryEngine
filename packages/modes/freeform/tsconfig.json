{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  // Tests, and the helpers that exist only for them, are typechecked by
  // tsconfig.spec.json instead. See the root tsconfig.json for why.
  "exclude": ["src/**/*.test.ts", "src/**/test-*.ts"],
  // `sdk` and nothing else, which is the whole of docs/design/19-tech-stack.md
  // §10: a reference to `../../server` would resolve, compile, and quietly
  // reverse the decision this package exists to enforce. `shared` comes through
  // `sdk`'s re-export rather than as a second reference — one vocabulary, one
  // path to it.
  "references": [{ "path": "../../sdk" }]
}
