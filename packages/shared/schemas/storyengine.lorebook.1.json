              }
            ]
          },
          "mime": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          },
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "ref": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "tags": {
