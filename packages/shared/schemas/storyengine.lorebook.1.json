{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyengine.dev/schemas/storyengine.lorebook.1.json",
  "title": "Lorebook",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "description",
    "scope",
    "enabled",
    "scanDepth",
    "tokenBudget",
    "entryLimit",
    "recursiveScanning",
    "maxRecursionDepth",
    "folders",
    "entries",
    "tags",
    "media",
    "primaryMediaId",
    "assets",
    "provenance",
    "generated",
    "metadata"
  ],
  "properties": {
    "schema": {
      "const": "storyengine.lorebook/1",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "scope": {
      "title": "LoreScope",
      "anyOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "global",
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "actorIds"
          ],
          "properties": {
            "kind": {
              "const": "linked",
              "type": "string"
            },
            "actorIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "scanDepth": {
      "default": 2,
      "type": "number"
    },
    "tokenBudget": {
      "default": 2048,
      "type": "number"
    },
    "entryLimit": {
      "minimum": 1,
      "maximum": 1000,
      "default": 100,
      "type": "number"
    },
    "recursiveScanning": {
      "default": false,
      "type": "boolean"
    },
    "maxRecursionDepth": {
      "default": 3,
      "type": "number"
    },
    "folders": {
      "type": "array",
      "items": {
        "title": "LoreFolder",
        "type": "object",
        "required": [
          "id",
          "name",
          "parentFolderId",
          "enabled",
          "order"
        ],
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "parentFolderId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "order": {
            "type": "number"
          }
        }
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "title": "PlotHook",
        "description": "Fully stable, because the rule-typed fields are gone. An earlier draft carried `requires?: Predicate[]` and `onFire?: Effect[]`; that vocabulary is 2.0, and rather than ship a /1 schema with two fields typed against something unwritten they are removed. They return additively, so the schema stays /1 when the vocabulary arrives.",
        "type": "object",
        "required": [
          "id",
          "title",
          "premise",
          "magnitude",
          "involves",
          "weight",
          "delivery",
          "once"
        ],
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "premise": {
            "type": "string"
          },
          "magnitude": {
            "anyOf": [
              {
                "const": "sweeping",
                "type": "string"
              },
              {
                "const": "local",
                "type": "string"
              },
              {
                "const": "personal",
                "type": "string"
              }
            ]
          },
          "involves": {
            "type": "array",
            "items": {
              "title": "Ref",
              "description": "A link to another object. Resolution order is always: exact id, then case-insensitive name, then show as missing and continue. Never blocks.",
              "type": "object",
              "required": [
                "id",
                "name"
              ],
              "properties": {
                "id": {
                  "minLength": 1,
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "fingerprint": {
                  "type": "string"
                }
              }
            }
          },
          "blockedBy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notBefore": {
            "type": "object",
            "properties": {
              "turn": {
                "type": "number"
              },
              "afterHook": {
                "type": "string"
              }
            }
          },
          "weight": {
            "type": "number"
          },
          "delivery": {
            "anyOf": [
              {
                "const": "guidance",
                "type": "string"
              },
              {
                "const": "seed",
                "type": "string"
              },
              {
                "const": "immediate",
                "type": "string"
              }
            ]
          },
          "once": {
            "type": "boolean"
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "title": "LoreEntry",
        "description": "Deliberately absent: `embedding` (derived — belongs in the index, and would otherwise put megabytes of one install’s vector arithmetic into every shared lorebook), `dynamicState`, quest structures, `relationships`, `activationConditions` and `schedule`.",
        "type": "object",
        "required": [
          "id",
          "name",
          "content",
          "description",
          "keys",
          "secondaryKeys",
          "selectiveLogic",
          "selective",
          "matchWholeWords",
          "caseSensitive",
          "useRegex",
          "scanDepth",
          "enabled",
          "constant",
          "probability",
          "sticky",
          "cooldown",
          "delay",
          "ephemeral",
          "position",
          "outletName",
          "depth",
          "order",
          "role",
          "group",
          "groupWeight",
          "folderId",
          "actorFilter",
          "actorTagFilter",
          "generationTriggerFilter",
          "additionalMatchingSources",
          "preventRecursion",
          "excludeRecursion",
          "delayUntilRecursion",
          "tag",
          "media",
          "locked",
          "metadata"
        ],
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "secondaryKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "selectiveLogic": {
            "anyOf": [
              {
                "const": "and_any",
                "type": "string"
              },
              {
                "const": "and_all",
                "type": "string"
              },
              {
                "const": "not_any",
                "type": "string"
              },
              {
                "const": "not_all",
                "type": "string"
              }
            ]
          },
          "selective": {
            "type": "boolean"
          },
          "matchWholeWords": {
            "type": "boolean"
          },
          "caseSensitive": {
            "type": "boolean"
          },
          "useRegex": {
            "type": "boolean"
          },
          "scanDepth": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "constant": {
            "type": "boolean"
          },
          "probability": {
            "anyOf": [
              {
                "minimum": 0,
                "maximum": 100,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "sticky": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "cooldown": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "delay": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "ephemeral": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "position": {
            "anyOf": [
              {
                "const": "before_char",
                "type": "string"
              },
              {
                "const": "after_char",
                "type": "string"
              },
              {
                "const": "at_depth",
                "type": "string"
              },
              {
                "const": "outlet",
                "type": "string"
              }
            ]
          },
          "outletName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "depth": {
            "type": "number"
          },
          "order": {
            "type": "number"
          },
          "role": {
            "anyOf": [
              {
                "const": "system",
                "type": "string"
              },
              {
                "const": "user",
                "type": "string"
              },
              {
                "const": "assistant",
                "type": "string"
              }
            ]
          },
          "group": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "groupWeight": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "folderId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "actorFilter": {
            "anyOf": [
              {
                "title": "LoreFilter",
                "type": "object",
                "required": [
                  "mode",
                  "values"
                ],
                "properties": {
                  "mode": {
                    "anyOf": [
                      {
                        "const": "any",
                        "type": "string"
                      },
                      {
                        "const": "include",
                        "type": "string"
                      },
                      {
                        "const": "exclude",
                        "type": "string"
                      }
                    ]
                  },
                  "values": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "actorTagFilter": {
            "anyOf": [
              {
                "title": "LoreFilter",
                "type": "object",
                "required": [
                  "mode",
                  "values"
                ],
                "properties": {
                  "mode": {
                    "anyOf": [
                      {
                        "const": "any",
                        "type": "string"
                      },
                      {
                        "const": "include",
                        "type": "string"
                      },
                      {
                        "const": "exclude",
                        "type": "string"
                      }
                    ]
                  },
                  "values": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "generationTriggerFilter": {
            "anyOf": [
              {
                "title": "LoreFilter",
                "type": "object",
                "required": [
                  "mode",
                  "values"
                ],
                "properties": {
                  "mode": {
                    "anyOf": [
                      {
                        "const": "any",
                        "type": "string"
                      },
                      {
                        "const": "include",
                        "type": "string"
                      },
                      {
                        "const": "exclude",
                        "type": "string"
                      }
                    ]
                  },
                  "values": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "additionalMatchingSources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preventRecursion": {
            "type": "boolean"
          },
          "excludeRecursion": {
            "type": "boolean"
          },
          "delayUntilRecursion": {
            "type": "boolean"
          },
          "extensionActivations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "by",
                "config"
              ],
              "properties": {
                "by": {
                  "type": "string"
                },
                "config": {}
              }
            }
          },
          "stateSchema": {},
          "tag": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "media": {
            "type": "array",
            "items": {
              "title": "EmbeddedMedia",
              "description": "A *reference* to bytes carried by the container, never the bytes themselves. The manifest form works in every container: a PNG private chunk, a zip entry, or a folder.",
              "type": "object",
              "required": [
                "id",
                "role",
                "mime",
                "digest",
                "bytes",
                "ref",
                "tags"
              ],
              "properties": {
                "id": {
                  "minLength": 1,
                  "type": "string"
                },
                "role": {
                  "title": "MediaRole",
                  "anyOf": [
                    {
                      "const": "portrait-source",
                      "type": "string"
                    },
                    {
                      "const": "reference",
                      "type": "string"
                    },
                    {
                      "const": "expression",
                      "type": "string"
                    },
                    {
                      "const": "pose",
                      "type": "string"
                    },
                    {
                      "const": "style",
                      "type": "string"
                    },
                    {
                      "const": "map",
                      "type": "string"
                    },
                    {
                      "const": "gallery",
                      "type": "string"
                    }
                  ]
                },
                "mime": {
                  "type": "string"
                },
                "digest": {
                  "type": "string"
                },
                "bytes": {
                  "minimum": 0,
                  "type": "integer"
                },
                "ref": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "width": {
                  "minimum": 0,
                  "type": "integer"
                },
                "height": {
                  "minimum": 0,
                  "type": "integer"
                },
                "crop": {
                  "title": "SourceRect",
                  "description": "Normalised 0..1 rectangle of a source image. Normalised rather than pixels so it survives the source being resized or re-encoded.",
                  "type": "object",
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "properties": {
                    "x": {
                      "minimum": 0,
                      "maximum": 1,
                      "type": "number"
                    },
                    "y": {
                      "minimum": 0,
                      "maximum": 1,
                      "type": "number"
                    },
                    "width": {
                      "minimum": 0,
                      "maximum": 1,
                      "type": "number"
                    },
                    "height": {
                      "minimum": 0,
                      "maximum": 1,
                      "type": "number"
                    }
                  }
                },
                "generated": {
                  "title": "GeneratedFieldProvenance",
                  "description": "Retained generated value for one field, so an edit can be reverted and the source disclosed. Keyed by dotted path in `generated`.",
                  "type": "object",
                  "required": [
                    "original",
                    "at",
                    "model",
                    "seed",
                    "unreviewed"
                  ],
                  "properties": {
                    "original": {
                      "type": "string"
                    },
                    "at": {
                      "format": "date-time",
                      "description": "ISO 8601 timestamp. Never epoch milliseconds.",
                      "type": "string"
                    },
                    "model": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "seed": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "unreviewed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "locked": {
            "type": "boolean"
          },
          "metadata": {
            "type": "object",
            "patternProperties": {
              "^(.*)$": {}
            }
          }
        }
      }
    },
    "writingSamples": {
      "type": "array",
      "items": {
        "title": "WritingSample",
        "description": "Prose offered as an exemplar of tone rather than a description of it. Carried by Actor, Treatment and Lorebook; positioned and budgeted by a preset slot, never injected merely by existing.",
        "type": "object",
        "required": [
          "id",
          "title",
          "body",
          "enabled",
          "note"
        ],
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "priority": {
            "type": "number"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "media": {
      "type": "array",
      "items": {
        "title": "EmbeddedMedia",
        "description": "A *reference* to bytes carried by the container, never the bytes themselves. The manifest form works in every container: a PNG private chunk, a zip entry, or a folder.",
        "type": "object",
        "required": [
          "id",
          "role",
          "mime",
          "digest",
          "bytes",
          "ref",
          "tags"
        ],
        "properties": {
          "id": {
            "minLength": 1,
