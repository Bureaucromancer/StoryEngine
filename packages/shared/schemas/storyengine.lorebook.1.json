            },
            {
              "const": "import",
              "type": "string"
            },
            {
              "const": "generated",
              "type": "string"
            },
            {
              "const": "package",
              "type": "string"
            },
            {
              "const": "session",
              "type": "string"
            }
          ]
        },
        "creator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
