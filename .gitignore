node_modules/
dist/
# The client emits its declarations here rather than to `dist/`, which is where
# its Vite bundle goes — so it needs naming separately or it is tracked build
# output. It was, from d4a8afa until the rule arrived.
dist-types/
coverage/
*.tsbuildinfo
.vite/
.vitest/

# The runtime data directory. Files on disk are canonical (docs/design/02-data-model.md
# §5) and they are the user's, never the repository's.
data/

# Local config, never committed.
config.json

# The build's own identity (`pnpm build:identify`). Written by the release
# build and shipped inside the artifact, never committed: a file in the tree
# saying which commit this is would be wrong the moment anybody committed
# anything (docs/design/workplan/23-p6a-alpha-1.md §1.5).
packages/server/build-info.json

# Captured server logs (`pnpm dev:logged`). Evidence from a run, not source —
# and a log carries whatever was in a session, which is the user's.
logs/

# Recorded provider exchanges (`pnpm dev:logged`, or `--capture`). A cassette
# carries the whole rendered prompt — the user's prose — so the raw recordings
# stay local. The committed corpus is curated copies in
# packages/server/src/providers/fixtures/, moved there deliberately.
captures/

.env
.env.local

# OS and editor cruft. macOS drops .DS_Store into every directory Finder opens,
# and a pair of them reached the repository in ff59ee8 before this rule existed.
.DS_Store
Thumbs.db
