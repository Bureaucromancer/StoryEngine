// StoryEngine configuration.
//
// Every key here is optional — delete this file and the defaults below are what
// you get, which is a working install. Copy it to `data/config.json` and change
// what you need.
//
// JSON does not have comments, so this file is not loadable as-is. That is the
// one real cost of JSON everywhere (docs/design/03-data-model.md §5.4), and this
// commented example is how it is paid: strip the comments, or use the settings
// UI, which is the primary path.
//
// Every key is annotated with what it takes to apply:
//
//   live      re-read on change, effective immediately
//   reconnect effective for new sessions, or after clients reconnect
//   restart   anything establishing a listener or a file handle
//
// The server derives its own "restart required" notice from these tiers rather
// than from a list someone maintains by hand — see docs/design/22-internal-contracts.md §4.

{
  // restart — where everything lives. Relative paths resolve against the
  // working directory.
  "dataDir": "./data",

  "server": {
    // restart — LOOPBACK BY DEFAULT, and deliberately.
    //
    // Until you create the first admin account, whoever can reach this port can
    // claim it. Binding 127.0.0.1 means that window is only open to this
    // machine. Set "0.0.0.0" when you want the rest of the house to reach it —
    // and know that you are doing it (docs/design/09-server-multiuser-deployment.md §5.1).
    //
    // You can set it without this file at all: SE_HOST=0.0.0.0. Four keys take
    // an environment variable — SE_DATA_DIR, SE_HOST, SE_PORT and
    // SE_CLIENT_ROOT — and they are the ones needed before this file can be
    // read at all, which is why they and not the rest. The order is defaults, then the environment, then this file, so
    // a value written here wins over the variable: this file is what the
    // settings page writes, and a setting you changed in the UI must not be
    // silently outranked by something in your shell. The server logs a warning
    // when a variable is set and this file speaks for the same key.
    //
    // That variable is how the container image binds 0.0.0.0, because a
    // container's 127.0.0.1 is its own loopback and would be unreachable no
    // matter how you mapped the port. There, the `-p` flag is your explicit act
    // instead — and it is the same variable you would use here, not a different
    // build, which is deliberate: a hidden difference between artifacts is a
    // support burden shaped like a security feature.
    //
    // There is no HTTPS. On a LAN it cannot be done well without a real domain
    // or a private CA, and self-signed certificates teach people to click
    // through warnings. Put a reverse proxy in front if you want TLS.
    "host": "127.0.0.1",

    // restart
    "port": 8080,

    // restart — trust X-Forwarded-* headers. Only turn this on when something
    // you control is actually in front, or client addresses become spoofable.
    "trustProxy": false,

    // restart — put Secure on the session and CSRF cookies. Turn this on when
    // there is TLS in front of this server, and only then: a Secure cookie is
    // not sent back over plain HTTP, so switching it on without HTTPS makes
    // signing in fail with no error anywhere — the browser just declines.
    //
    // It is not derived from the bind address on purpose. Plain HTTP on a LAN
    // you trust is a supported way to run this (docs/design/09-server-multiuser-deployment.md §5.1), and a
    // rule that hardened the cookie whenever you bound 0.0.0.0 would lock out
    // exactly that install.
    "cookieSecure": false,

    // restart — where the built web client is, so this one process serves both
    // the API and the UI on one port. Empty means serve nothing, which is the
    // default and what development wants: `pnpm dev` runs two processes, with
    // Vite on its own port proxying /api back here.
    //
    // Set it to a directory holding index.html and its assets — the container
    // image does, which is what makes the mapped port serve a UI rather than a
    // 404. A relative path is resolved against the working directory. Anything
    // under /api is still the API: an address there that matches no route
    // answers JSON, never the app shell, because a client parsing JSON is
    // better served by a 404 than by a page.
    "clientRoot": "",

    // restart — the name this install answers to on the local network, as
    // <name>.local (docs/design/09-server-multiuser-deployment.md §5.1).
    //
    // With the default, a household reaches the server at
    // http://storyengine.local:8080 instead of typing an IP address somebody
    // read out over the phone. Two installs on one network need two names —
    // "attic" and "study" — because the server checks whether the name is
    // already taken before it claims one, and the second would otherwise simply
    // go unnamed.
    //
    // Set it to "" to advertise nothing. Advertising only happens when
    // server.host is not loopback in any case: an install only this machine can
    // reach has nobody to tell.
    //
    // On macOS, and on most Linux desktops, a system daemon already holds the
    // mDNS port. The server says so in its log and carries on; those machines
    // are usually reachable by their own hostname already.
    "mdnsName": "storyengine"
  },

  "auth": {
    // live — the shortest password this install accepts when one is SET.
    //
    // It applies to first-run setup, an admin creating an account, an admin
    // resetting somebody's password, and a person changing their own. It does
    // not apply when a password is checked: raising this never locks anyone out
    // of an account they already have, and there is no forced change.
    //
    // 0 means the empty string is a valid password. The box stays on every form
    // and you may leave it blank. That is a defensible setting for a machine
    // only you can reach, and a bad one for anything else. The most this may be
    // is 128.
    //
    // --reset-password on the console honours no minimum at all, including this
    // one. Access to the host is already the highest authority this software
    // recognises (docs/design/09-server-multiuser-deployment.md §5.1), so the break-glass path takes what it
    // is given.
    "minPasswordLength": 8,

    // live — which arrival screen an unauthenticated visitor meets: "form" or
    // "gallery" (docs/design/12-account-gallery.md §1.1).
    //
    // "form" is the default and is what every install has always shown: a
    // handle box and a password box. "gallery" replaces the handle box with a
    // grid of the accounts on this install, each with its face and display
    // name — you pick yours and then type your password, which is the same
    // login request either way.
    //
    // The default is "form" because a gallery discloses who has an account
    // here, and a disclosure should be a decision somebody made. Individual
    // accounts can opt out of the grid ("Shown on the sign-in screen" in
    // Settings), and an admin can hide any of them; a hidden account still
    // signs in by typing its handle.
    "loginScreen": "form"
  },

  "log": {
    // live — "silent" also works, and is what the test suite runs at.
    "level": "info",
    // restart — one value today. Pipe it through a formatter if you want it
    // pretty in a terminal; the server does not carry one.
    "format": "json"
  },

  "index": {
    // restart — rescan the whole data directory at start-up.
    //
    // Not normally needed: the index is derived and disposable, so if you doubt
    // it you can simply delete data/index/index.sqlite and it will be rebuilt.
    // This is the same operation without the deletion.
    "rebuildOnStart": false
  },

  "sessions": {
    // live
    "snapshotEveryNTurns": 10,

    // reconnect — how often an idle event stream sends a keepalive.
    //
    // A keepalive is a property of a connection, and an open stream keeps the
    // interval it opened with, so changing this reaches new streams only.
    //
    // Every millisecond setting here stops at 2147483647 (about 24.8 days),
    // the longest delay a timer holds: a larger one is not refused by Node, it
    // becomes one millisecond.
    "streamKeepaliveMs": 15000,

    // live — how long streamed text accumulates before a durable checkpoint.
    //
    // The operational store commits with synchronous writes, so a transaction
    // per token would be an fsync storm. Lower it if you want a killed server
    // to lose less of an in-flight reply; 0 checkpoints every chunk.
    "streamCoalesceMs": 250
  },

  "limits": {
    // live — the largest upload accepted, in megabytes: one file, or a whole
    // folder added up. Read on every upload, so a change applies to the next.
    "maxUploadMb": 64,
    // live — the largest archive or database accepted by the one-file import,
    // in megabytes. An Aventuras backup is somebody's whole install with its
    // pictures in it, so these are written to disk as they arrive rather than
    // held in memory, and bounded by this rather than by maxUploadMb. Lower it
    // to tighten what an account may send; raising maxUploadMb does not raise
    // this. A reverse proxy in front has a body limit and a read timeout of
    // its own, which will refuse a large upload before this does (docs/deploy.md).
    "maxImportUploadMb": 1024,
    // live
    "extensionStorageQuotaMb": 32,

    // live — the context window a turn may assemble into, when the endpoint
    // does not say how large it is.
    //
    // Most OpenAI-compatible endpoints do not report a context length, and
    // StoryEngine will not invent one it cannot verify — so without this a
    // turn has no budget to work against. A connection may override it, which
    // is the better place to say it: the number is a fact about that endpoint.
    "contextTokens": 8192,

    // live — held back out of the context window for the reply itself, when a
    // call does not say how long it may be.
    "reservedCompletionTokens": 1024,

    // live — how long one call may go without sending anything before the turn
    // gives up on it and fails, in milliseconds. Silence, not total length: a
    // streamed chunk resets the clock, so a long answer is not interrupted but
    // an endpoint that has stopped responding does not hold a session open
    // forever. Five minutes by default, which is generous enough for a slow
    // first token from a model running on your own machine.
    //
    // Set it to 0 to turn it off entirely, if you are running something slower
    // than any number here would allow for.
    "providerTimeoutMs": 300000
  },

  "trash": {
    // live — how long deleted objects stay recoverable.
    "retentionDays": 30
  },

  "backup": {
    // live — the install's own backup, on a timer. "off", "daily" or "weekly".
    //
    // This is the whole data directory: every account's library and sessions,
    // the operational store, and — when "contents" is "full" — accounts.json
    // and the session signing key. It lands in data/backups/ and is meant to be
    // copied somewhere else; nothing here removes old ones yet.
    "frequency": "off",

    // live — take one on every server start, as well as on the frequency above.
    //
    // For a machine that is not on all the time, where a fixed frequency may
    // never come round. Independent of "frequency" rather than a value in it,
    // so an install that is usually up can have both. A start backup is skipped
    // if the newest one is under an hour old.
    "onStart": false,

    // live — "full" or "redacted".
    //
    // "full" restores to a working install and therefore carries credentials.
    // "redacted" leaves out accounts.json, the connections and the session key:
    // safer to store elsewhere, and it restores to an install nobody can sign
    // into.
    "contents": "full"
  },

  "history": {
    // live — versions kept per object. Pinned versions are exempt, and 0
    // keeps every version.
    "keepPerObject": 50
  },

  "updates": {
    // live — a daily, cached check of the release feed for your channel.
    //
    // It is an update check, not telemetry: it sends nothing beyond what a
    // version comparison needs — no install id, no usage counts, no
    // configuration. Set false and nothing leaves this machine.
    "checkEnabled": true,

    // live — "latest", "testing" or "nightly".
    "channel": "latest"
  },

  "dev": {
    // restart
    "enabled": false
  }
}
