{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "tools/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "vitest.config.ts",
    "packages/server/src/types/**/*.d.ts"
  ],
  "exclude": ["tools/lint-fixtures/fixtures/**"]
}
